%% awesome-cv/utils.sty
% Low-level utilities: column types, horizontal rule, empty-check.
% Persian edition: the column *order* is the same as the English module (bidi
% emits the columns of a tabular right-to-left, so the first column of the
% spec becomes the rightmost one and the whole table mirrors for free), but the
% alignment *inside* each cell has to be mirrored by hand, because xepersian
% does not swap \raggedleft and \raggedright:
%
%   English  r | L | R   ->  category left, value/body flush left, date right
%   Persian  r | L | R   ->  category right, value/body flush right, date left
%
% Hence L hugs the reading start (flush right) and R hugs the reading end
% (flush left). With the English definitions the Persian rows would place the
% date/location/link directly against the title instead of at the outer edge of
% the row.
\ProvidesPackage{awesome-cv/utils}[2026/09/28 v2.0 Awesome-CV utilities (Persian)]

% Use to align an element of tabular table
\newcolumntype{L}[1]{>{\raggedleft\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{C}[1]{>{\centering\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{R}[1]{>{\raggedright\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}

% Use to draw horizontal line with specific thickness
\def\vhrulefill#1{\leavevmode\leaders\hrule\@height#1\hfill \kern\z@}

% Use to execute conditional statements by checking empty string
\newcommand*{\ifempty}[3]{\ifthenelse{\isempty{#1}}{#2}{#3}}
